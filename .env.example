# 代理地址（tun2socks 格式），密码里的特殊字符要 URL 编码，例如 @ -> %40
# {SESSION} 会在每次启动时替换为随机串（住宅代理的粘性会话参数 → 每次重启换出口 IP）
#   socks5://user-session-{SESSION}:pass@gw.example.com:1080
#   socks5://user:pass@1.2.3.4:1080
#   http://user:pass@1.2.3.4:8080
#   ss://aes-256-gcm:password@1.2.3.4:8388
PROXY1=socks5://user:pass@1.2.3.4:1080
PORT1=6081

# noVNC 访问密码（VNC 协议只取前 8 位）；留空则每次启动随机生成并打印到 docker logs
VNC_PASSWORD=
# 容器和 Chrome 的时区；auto = 跟随代理出口 IP 所在地
TZ=Etc/UTC
# Chrome 界面语言 + Accept-Language；auto = 跟随出口 IP 所在国家
LANGUAGE=en_US:en
# random = 每次会话随机常见分辨率；也可以写死，例如 1920x1080
RESOLUTION=random
# Chrome 启动时打开的网址，多个用空格分隔，每个一个标签页
START_URL="https://claude.ai/login https://jjyycccai.cn https://ipinfo.io/json"
# 只允许 SSH 隧道访问时改为 127.0.0.1
BIND_ADDR=0.0.0.0
